{
  "name": "eraksha-exhibit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Exhibition display for eRaksha: adolescent mental health burden (verified estimates) and eRaksha coverage (verified or explicitly labelled scenarios).",
  "scripts": {
    "data": "./.venv/bin/python scripts/extract_ncmec.py && node scripts/build-data.mjs",
    "geo": "node scripts/build-geo.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "booth": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "marked": "^14.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.2",
    "d3-transition": "^3.0.1",
    "jsdom": "^25.0.1",
    "mapshaper": "^0.6.99",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
